#!/usr/bin/env bash
# heatsink — load/thermal guard for AI coding agents.
set -uo pipefail

hs_src="$0"
while [ -h "$hs_src" ]; do hs_src=$(readlink "$hs_src"); done
HS_ROOT="$(cd "$(dirname "$hs_src")/.." && pwd)"
# shellcheck source=lib/signals.sh
. "$HS_ROOT/lib/signals.sh"
# shellcheck source=lib/policy.sh
. "$HS_ROOT/lib/policy.sh"
# shellcheck source=lib/rewrite.sh
. "$HS_ROOT/lib/rewrite.sh"
# shellcheck source=lib/procs.sh
. "$HS_ROOT/lib/procs.sh"

usage() {
  cat >&2 <<'EOF'
usage: heatsink <command> [args]
  check --command "<cmd>" [--json]   verdict: ok|warn|throttle|deny
  doctor                             why is my machine hot?
  reap [--kill]                      find (and optionally kill) orphaned burners
  wrap -- <cmd>                      throttle-if-needed, then run
  hook <claude-code|cursor|codex>    harness hook entrypoint (stdin JSON)
EOF
  exit 2
}

# Sets: HS_VERDICT HS_LOAD HS_CORES HS_THERMAL HS_REWRITTEN HS_REASON
hs_evaluate() {
  local command="$1" lvl n rc
  HS_LOAD=$(hs_load1); HS_CORES=$(hs_cores); HS_THERMAL=$(hs_thermal)
  HS_VERDICT=ok; HS_REWRITTEN=""; HS_REASON=""
  [ -n "$command" ] && hs_is_heavy "$command" || return 0
  lvl=$(hs_level "$HS_LOAD" "$HS_CORES" "$HS_THERMAL")
  case "$lvl" in
    2)
      HS_VERDICT=deny
      HS_REASON="load $HS_LOAD on $HS_CORES cores (thermal: $HS_THERMAL) — oversubscribed. Wait for load to drop, or run with reduced parallelism." ;;
    1)
      n=$(hs_target_workers "$HS_CORES")
      HS_REWRITTEN=$(hs_rewrite "$command" "$n") && rc=0 || rc=$?
      case "$rc" in
        0) HS_VERDICT=throttle
           HS_REASON="load $HS_LOAD on $HS_CORES cores — throttled to $n workers." ;;
        1) HS_VERDICT=warn HS_REWRITTEN=""
           HS_REASON="load $HS_LOAD on $HS_CORES cores — near saturation; no safe worker knob for this command." ;;
        *) HS_VERDICT=ok HS_REWRITTEN="" ;;
      esac ;;
  esac
  return 0
}

cmd_check() {
  local command="" json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --command) command="${2:-}"; shift 2 2>/dev/null || break ;;
      --json)    json=1; shift ;;
      *)         shift ;;
    esac
  done
  hs_evaluate "$command"
  if [ "$json" -eq 1 ]; then
    command -v jq >/dev/null 2>&1 || { echo '{"verdict":"ok"}'; return 0; }  # fail open
    jq -n --arg v "$HS_VERDICT" --arg l "$HS_LOAD" --arg c "$HS_CORES" \
          --arg t "$HS_THERMAL" --arg r "$HS_REWRITTEN" --arg m "$HS_REASON" \
      '{verdict:$v, load:($l|tonumber? // 0), cores:($c|tonumber? // 0), thermal:$t,
        rewritten:(if $r=="" then null else $r end),
        reason:(if $m=="" then null else $m end)}'
  else
    if [ "$HS_VERDICT" = throttle ]; then echo "throttle: $HS_REWRITTEN"; else echo "$HS_VERDICT"; fi
  fi
  [ "$HS_VERDICT" = deny ] && return 1
  return 0
}

cmd_wrap() {
  [ "${1:-}" = "--" ] && shift
  [ $# -ge 1 ] || usage
  local command; command=$(printf '%q ' "$@")
  hs_evaluate "$command"
  case "$HS_VERDICT" in
    deny)
      echo "heatsink: DENIED — $HS_REASON" >&2
      return 75 ;;  # EX_TEMPFAIL
    throttle)
      echo "heatsink: throttled -> $HS_REWRITTEN" >&2
      eval "$HS_REWRITTEN" ;;
    warn)
      echo "heatsink: $HS_REASON (running anyway)" >&2
      "$@" ;;
    *)
      "$@" ;;
  esac
}

cmd_doctor() {
  local load cores thermal ratio
  load=$(hs_load1); cores=$(hs_cores); thermal=$(hs_thermal)
  ratio=$(awk -v l="$load" -v c="$cores" 'BEGIN { if (c>0) printf "%.1f", l/c; else print "?" }')
  echo "heatsink doctor"
  echo
  echo "  load:    $load on $cores cores (${ratio}x)  thermal: $thermal"
  echo
  echo "  top burners:"
  hs_top_burners 6 | awk '{printf "    %-7s %-6s %-12s %s\n", $1, $4"%", $5, substr($0, index($0,$6))}'
  echo
  local orphans; orphans=$(hs_orphans)
  if [ -n "$orphans" ]; then
    echo "  orphaned burners (parent gone, still spinning):"
    echo "$orphans" | awk '{printf "    pid %-7s %-6s up %-12s %s\n", $1, $2"%", $3, substr($0, index($0,$4))}'
    echo
    echo "  verdict: orphaned processes are burning CPU for nothing."
    echo "           reap them:  heatsink reap        (report)"
    echo "                       heatsink reap --kill (terminate)"
  else
    awk -v l="$load" -v c="$cores" 'BEGIN {
      r = (c>0) ? l/c : 0
      if      (r >= 2.0) print "  verdict: heavily oversubscribed — stop or throttle the biggest burners above."
      else if (r >= 0.9) print "  verdict: near saturation — avoid starting more parallel work."
      else               print "  verdict: healthy — nothing to do."
    }'
  fi
}

cmd_reap() {
  local do_kill=0 dry_run=0 a
  for a in "$@"; do
    case "$a" in
      --kill)    do_kill=1 ;;
      --dry-run) dry_run=1 ;;
    esac
  done
  # --dry-run always wins, regardless of flag order — safety direction.
  [ "$dry_run" -eq 1 ] && do_kill=0
  local orphans; orphans=$(hs_orphans)
  if [ -z "$orphans" ]; then echo "heatsink: no orphaned burners found."; return 0; fi
  echo "orphaned burners:"
  echo "$orphans" | awk '{printf "  pid %-7s %-6s up %-12s %s\n", $1, $2"%", $3, substr($0, index($0,$4))}'
  if [ "$do_kill" -eq 0 ]; then
    echo
    echo "report-only. re-run with --kill to terminate these."
    return 0
  fi
  local pids; pids=$(echo "$orphans" | awk '{print $1}')
  echo
  echo "sending SIGTERM..."
  # shellcheck disable=SC2086
  kill $pids 2>/dev/null || true
  sleep 5
  local survivors=""
  local p
  for p in $pids; do kill -0 "$p" 2>/dev/null && survivors="$survivors $p"; done
  if [ -n "$survivors" ]; then
    echo "sending SIGKILL to survivors:$survivors"
    # shellcheck disable=SC2086
    kill -9 $survivors 2>/dev/null || true
  fi
  echo "done."
}

cmd_hook() {
  local adapter="${1:-}"
  case "$adapter" in
    claude-code|cursor|codex) exec "$HS_ROOT/adapters/$adapter/hook.sh" ;;
    *) usage ;;
  esac
}

[ $# -ge 1 ] || usage
sub="$1"; shift
case "$sub" in
  check)  cmd_check "$@" ;;
  doctor) cmd_doctor "$@" ;;
  reap)   cmd_reap "$@" ;;
  wrap)   cmd_wrap "$@" ;;
  hook)   cmd_hook "$@" ;;
  *)      usage ;;
esac
